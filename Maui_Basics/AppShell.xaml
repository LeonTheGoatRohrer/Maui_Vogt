<!-- Maui_Basics\AppShell.xaml -->
<Shell
    x:Class="Maui_Basics.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Maui_Basics.Views"
    FlyoutBehavior="Disabled"
    Title="Maui_Basics">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="About"
            ContentTemplate="{DataTemplate views:AboutUsPage}"
            Route="AboutPage" />
        <ShellContent
            Title="Components"
            ContentTemplate="{DataTemplate views:ComponentsPage}"
            Route="ComponentsPage" />
    </TabBar>
</Shell>